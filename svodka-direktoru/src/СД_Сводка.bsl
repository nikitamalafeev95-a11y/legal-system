// Итог по ресурсу регистра накопления.
// ВидИтога: "Остаток" (на дату Начало), "Оборот", "Приход", "Расход" (за период Начало - Конец).
// Ресурс берется первый существующий из списка кандидатов: суммы в рублях приоритетнее.
Функция ИтогРегистраНакопления(ИмяРегистра, ВидИтога, Начало, Конец = Неопределено,
	Кандидаты = "СуммаРегл,СуммаУпр,Сумма")

	Ресурс = ИмяРесурса(ИмяРегистра, Кандидаты);

	Запрос = Новый Запрос;
	Если ВидИтога = "Остаток" Тогда
		Таблица = ИмяРегистра + ".Остатки(&Начало)";
	ИначеЕсли ВидИтога = "Оборот" Тогда
		Таблица = ИмяРегистра + ".Обороты(&Начало, &Конец)";
	Иначе
		Таблица = ИмяРегистра + ".Обороты(&Начало, &Конец)";
	КонецЕсли;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ЕСТЬNULL(СУММА(Данные." + Ресурс + ВидИтога + "), 0) КАК Сумма
	|ИЗ
	|	РегистрНакопления." + Таблица + " КАК Данные";
	Запрос.УстановитьПараметр("Начало", Начало);
	Запрос.УстановитьПараметр("Конец", Конец);

	Выборка = Запрос.Выполнить().Выбрать();
	Выборка.Следующий();
	Возврат Выборка.Сумма;

КонецФункции

// Долги в разрезе контрагентов по регистру расчетов (РасчетыСКлиентами / РасчетыСПоставщиками).
// Положительный остаток регистра считается долгом.
Функция ДолгиТорговля(Период, ИмяРегистра)

	Ресурс = ИмяРесурса(ИмяРегистра, "СуммаРегл,СуммаУпр,Сумма");
	МетаРегистр = Метаданные.РегистрыНакопления[ИмяРегистра];
	ЕстьАналитика = МетаРегистр.Измерения.Найти("АналитикаУчетаПоПартнерам") <> Неопределено;
	ПолеКонтрагента = ?(ЕстьАналитика, "Остатки.АналитикаУчетаПоПартнерам.Контрагент", """Все контрагенты""");

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	%Контрагент% КАК Контрагент,
	|	СУММА(Остатки.%Ресурс%Остаток) КАК Долг
	|ПОМЕСТИТЬ ВТ_Долги
	|ИЗ
	|	РегистрНакопления.%Регистр%.Остатки(&НаДату) КАК Остатки
	|
	|СГРУППИРОВАТЬ ПО
	|	%Контрагент%
	|
	|ИМЕЮЩИЕ
	|	СУММА(Остатки.%Ресурс%Остаток) > 0
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ПРЕДСТАВЛЕНИЕ(ВТ_Долги.Контрагент) КАК Наименование,
	|	ВТ_Долги.Долг КАК Долг
	|ИЗ
	|	ВТ_Долги КАК ВТ_Долги
	|
	|УПОРЯДОЧИТЬ ПО
	|	Долг УБЫВ";
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "%Контрагент%", ПолеКонтрагента);
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "%Ресурс%", Ресурс);
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "%Регистр%", ИмяРегистра);
	Запрос.УстановитьПараметр("НаДату", Период.НаДату);

	Возврат ДолгиИзРезультата(Запрос.Выполнить());

КонецФункции

// Возвращает первый существующий ресурс регистра накопления из списка кандидатов.
Функция ИмяРесурса(ИмяРегистра, Кандидаты)

	Ресурсы = Метаданные.РегистрыНакопления[ИмяРегистра].Ресурсы;
	Для Каждого Кандидат Из СтрРазделить(Кандидаты, ",", Ложь) Цикл
		Если Ресурсы.Найти(Кандидат) <> Неопределено Тогда
			Возврат Кандидат;
		КонецЕсли;
	КонецЦикла;
	ВызватьИсключение "В регистре " + ИмяРегистра + " не найден ни один из ресурсов: " + Кандидаты;

КонецФункции

