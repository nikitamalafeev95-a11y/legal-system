// Общий модуль СД_Сводка расширения "Сводка директору".
// Флаги модуля: Сервер. (Клиент, Вызов сервера, Внешнее соединение - выключены.)
//
// Собирает ключевые показатели из базы и отправляет их в Telegram и/или MAX.
// Поддерживаются два варианта учета, определяется автоматически:
//   "Торговля"    - УТ 11 / КА 2 / ERP (регистры накопления оперативного учета);
//   "Бухгалтерия" - БП 3.0 (регистр бухгалтерии Хозрасчетный).

#Область ПрограммныйИнтерфейс

// Обработчик регламентного задания СД_ОтправкаСводки.
Процедура ОтправитьСводкуПоРасписанию() Экспорт

	УстановитьПривилегированныйРежим(Истина);

	Настройки = ПолучитьНастройки();
	Если Не Настройки.ОтправлятьПоРасписанию Тогда
		Возврат;
	КонецЕсли;

	Результат = ОтправитьСводку(Настройки);
	Если Не Результат.Успех Тогда
		ЗаписатьОшибку(СтрСоединить(Результат.Ошибки, Символы.ПС));
	КонецЕсли;

КонецПроцедуры

// Возвращает структуру настроек со значениями по умолчанию.
Функция НастройкиПоУмолчанию() Экспорт

	Настройки = Новый Структура;
	Настройки.Вставить("ТокенTelegram", "");
	Настройки.Вставить("ЧатыTelegram", "");
	Настройки.Вставить("ТокенMAX", "");
	Настройки.Вставить("ЧатыMAX", "");
	Настройки.Вставить("ОтправлятьПоРасписанию", Ложь);
	Настройки.Вставить("ВремяОтправки", Дата(1, 1, 1, 9, 0, 0));
	Настройки.Вставить("ПоказыватьДеньги", Истина);
	Настройки.Вставить("ПоказыватьВыручку", Истина);
	Настройки.Вставить("ПоказыватьДвижениеДенег", Истина);
	Настройки.Вставить("ПоказыватьДебиторку", Истина);
	Настройки.Вставить("ПоказыватьКредиторку", Истина);
	Настройки.Вставить("КоличествоДолжников", 5);
	Настройки.Вставить("ПроксиСервер", "");
	Настройки.Вставить("ПроксиПорт", 0);
	Настройки.Вставить("ПроксиПользователь", "");
	Настройки.Вставить("ПроксиПароль", "");
	Возврат Настройки;

КонецФункции

// Читает сохраненные настройки из константы СД_НастройкиСводки.
Функция ПолучитьНастройки() Экспорт

	Настройки = НастройкиПоУмолчанию();

	УстановитьПривилегированныйРежим(Истина);
	Сохраненные = Константы.СД_НастройкиСводки.Получить().Получить();
	УстановитьПривилегированныйРежим(Ложь);

	Если ТипЗнч(Сохраненные) = Тип("Структура") Тогда
		ЗаполнитьЗначенияСвойств(Настройки, Сохраненные);
	КонецЕсли;

	Возврат Настройки;

КонецФункции

// Сохраняет настройки и перенастраивает регламентное задание.
Процедура СохранитьНастройки(Настройки) Экспорт

	УстановитьПривилегированныйРежим(Истина);

	Константы.СД_НастройкиСводки.Установить(Новый ХранилищеЗначения(Настройки));

	Задание = РегламентныеЗадания.НайтиПредопределенное(Метаданные.РегламентныеЗадания.СД_ОтправкаСводки);
	Если Задание <> Неопределено Тогда
		Расписание = Новый РасписаниеРегламентногоЗадания;
		Расписание.ПериодПовтораДней = 1;
		Расписание.ВремяНачала = Дата(1, 1, 1, Час(Настройки.ВремяОтправки), Минута(Настройки.ВремяОтправки), 0);
		Задание.Расписание = Расписание;
		Задание.Использование = Настройки.ОтправлятьПоРасписанию;
		Задание.Записать();
	КонецЕсли;

КонецПроцедуры

// Формирует текст сводки (разметка HTML: только теги <b>).
// Сводка строится за вчерашний день; остатки - на начало сегодняшнего дня.
Функция ТекстСводки(Настройки) Экспорт

	Сегодня = НачалоДня(ТекущаяДатаСеанса());
	Вчера = Сегодня - 86400;
	Период = Новый Структура;
	Период.Вставить("НаДату", Сегодня);
	Период.Вставить("НачалоДня", Вчера);
	Период.Вставить("КонецДня", КонецДня(Вчера));
	Период.Вставить("НачалоМесяца", НачалоМесяца(Вчера));

	ВариантУчета = ВариантУчета();

	Строки = Новый Массив;
	Строки.Добавить("<b>Сводка за " + Формат(Вчера, "ДФ=dd.MM.yyyy") + "</b>");

	Если ВариантУчета = "" Тогда
		Строки.Добавить("Конфигурация не поддерживается: не найдены регистры учета.");
		Возврат СтрСоединить(Строки, Символы.ПС);
	КонецЕсли;

	Если Настройки.ПоказыватьДеньги Тогда
		ДобавитьРаздел(Строки, "Деньги", ВариантУчета, Период, Настройки);
	КонецЕсли;
	Если Настройки.ПоказыватьВыручку Тогда
		ДобавитьРаздел(Строки, "Выручка", ВариантУчета, Период, Настройки);
	КонецЕсли;
	Если Настройки.ПоказыватьДвижениеДенег Тогда
		ДобавитьРаздел(Строки, "ДвижениеДенег", ВариантУчета, Период, Настройки);
	КонецЕсли;
	Если Настройки.ПоказыватьДебиторку Тогда
		ДобавитьРаздел(Строки, "Дебиторка", ВариантУчета, Период, Настройки);
	КонецЕсли;
	Если Настройки.ПоказыватьКредиторку Тогда
		ДобавитьРаздел(Строки, "Кредиторка", ВариантУчета, Период, Настройки);
	КонецЕсли;

	Возврат СтрСоединить(Строки, Символы.ПС);

КонецФункции

// Формирует сводку и отправляет ее во все настроенные чаты.
//
// Возвращаемое значение:
//   Структура - Успех (Булево), Отправлено (Число), Ошибки (Массив из Строка).
Функция ОтправитьСводку(Настройки) Экспорт

	Результат = Новый Структура("Успех, Отправлено, Ошибки", Ложь, 0, Новый Массив);

	Текст = ТекстСводки(Настройки);

	Если ЗначениеЗаполнено(Настройки.ТокенTelegram) Тогда
		Для Каждого Чат Из РазобратьСписок(Настройки.ЧатыTelegram) Цикл
			Ошибка = ОтправитьВTelegram(Настройки, Чат, Текст);
			УчестьРезультатОтправки(Результат, "Telegram, чат " + Чат, Ошибка);
		КонецЦикла;
	КонецЕсли;

	Если ЗначениеЗаполнено(Настройки.ТокенMAX) Тогда
		Для Каждого Чат Из РазобратьСписок(Настройки.ЧатыMAX) Цикл
			Ошибка = ОтправитьВMAX(Настройки, Чат, Текст);
			УчестьРезультатОтправки(Результат, "MAX, чат " + Чат, Ошибка);
		КонецЦикла;
	КонецЕсли;

	Если Результат.Отправлено = 0 И Результат.Ошибки.Количество() = 0 Тогда
		Результат.Ошибки.Добавить("Не настроен ни один получатель: укажите токен бота и идентификатор чата.");
	КонецЕсли;

	Результат.Успех = (Результат.Ошибки.Количество() = 0);
	Возврат Результат;

КонецФункции

// Возвращает чаты, которые недавно писали боту Telegram (метод getUpdates).
// Чтобы чат появился в списке, нужно написать боту любое сообщение.
//
// Возвращаемое значение:
//   Структура - Ошибка (Строка), Чаты (Массив из Строка вида "123456 - Иван Иванов").
Функция НайтиЧатыTelegram(Настройки) Экспорт

	Результат = Новый Структура("Ошибка, Чаты", "", Новый Массив);

	Ответ = ВыполнитьЗапрос("api.telegram.org", "/bot" + Настройки.ТокенTelegram + "/getUpdates",
		"GET", Неопределено, "", Настройки, Истина);
	Если Ответ.Ошибка <> "" Тогда
		Результат.Ошибка = Ответ.Ошибка;
		Возврат Результат;
	КонецЕсли;

	Попытка
		Чтение = Новый ЧтениеJSON;
		Чтение.УстановитьСтроку(Ответ.Тело);
		Данные = ПрочитатьJSON(Чтение, Истина);
		Чтение.Закрыть();

		Найденные = Новый Соответствие;
		Для Каждого Обновление Из Данные.Получить("result") Цикл
			Сообщение = Обновление.Получить("message");
			Если Сообщение = Неопределено Тогда
				Сообщение = Обновление.Получить("channel_post");
			КонецЕсли;
			Если Сообщение = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			Чат = Сообщение.Получить("chat");
			Идентификатор = Формат(Чат.Получить("id"), "ЧГ=0");
			Если Найденные.Получить(Идентификатор) <> Неопределено Тогда
				Продолжить;
			КонецЕсли;
			Название = Чат.Получить("title");
			Если Название = Неопределено Тогда
				Название = СокрЛП(Строка(Чат.Получить("first_name")) + " " + Строка(Чат.Получить("last_name")));
			КонецЕсли;
			Найденные.Вставить(Идентификатор, Истина);
			Результат.Чаты.Добавить(Идентификатор + " - " + Название);
		КонецЦикла;
	Исключение
		Результат.Ошибка = "Не удалось разобрать ответ Telegram: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;

	Возврат Результат;

КонецФункции

#КонецОбласти

#Область СборДанных

// "Торговля" - есть регистры оперативного учета УТ/КА/ERP, "Бухгалтерия" - есть Хозрасчетный, "" - не поддерживается.
Функция ВариантУчета()

	Если Метаданные.РегистрыНакопления.Найти("РасчетыСКлиентами") <> Неопределено
		И Метаданные.РегистрыНакопления.Найти("ДенежныеСредстваБезналичные") <> Неопределено Тогда
		Возврат "Торговля";
	ИначеЕсли Метаданные.РегистрыБухгалтерии.Найти("Хозрасчетный") <> Неопределено Тогда
		Возврат "Бухгалтерия";
	КонецЕсли;
	Возврат "";

КонецФункции

// Добавляет раздел в сводку. Ошибка в одном разделе не мешает остальным.
Процедура ДобавитьРаздел(Строки, ИмяРаздела, ВариантУчета, Период, Настройки)

	Строки.Добавить("");
	Попытка
		Если ИмяРаздела = "Деньги" Тогда
			Данные = ?(ВариантУчета = "Торговля", ДеньгиТорговля(Период), ДеньгиБухгалтерия(Период));
			Строки.Добавить("<b>Деньги на утро: " + Сумма(Данные.Касса + Данные.Банк) + "</b>");
			Строки.Добавить("  в кассе: " + Сумма(Данные.Касса));
			Строки.Добавить("  на счетах: " + Сумма(Данные.Банк));

		ИначеЕсли ИмяРаздела = "Выручка" Тогда
			Данные = ?(ВариантУчета = "Торговля", ВыручкаТорговля(Период), ВыручкаБухгалтерия(Период));
			Строки.Добавить("<b>Выручка</b>");
			Строки.Добавить("  вчера: " + Сумма(Данные.ЗаДень));
			Строки.Добавить("  с начала месяца: " + Сумма(Данные.ЗаМесяц));

		ИначеЕсли ИмяРаздела = "ДвижениеДенег" Тогда
			Если ВариантУчета = "Торговля" Тогда
				Данные = ДвижениеДенегТорговля(Период);
				Строки.Добавить("<b>Движение денег вчера</b> (с учетом внутренних перемещений)");
				Строки.Добавить("  поступило: " + Сумма(Данные.Приход));
				Строки.Добавить("  списано: " + Сумма(Данные.Расход));
			Иначе
				Данные = ДвижениеДенегБухгалтерия(Период);
				Строки.Добавить("<b>Движение денег вчера</b>");
				Строки.Добавить("  от покупателей: " + Сумма(Данные.Приход));
				Строки.Добавить("  поставщикам: " + Сумма(Данные.Расход));
			КонецЕсли;

		ИначеЕсли ИмяРаздела = "Дебиторка" Тогда
			Если ВариантУчета = "Торговля" Тогда
				Данные = ДолгиТорговля(Период, "РасчетыСКлиентами");
			Иначе
				Данные = ДолгиБухгалтерия(Период, "62", 1);
			КонецЕсли;
			ДобавитьДолги(Строки, "Нам должны покупатели", Данные, Настройки.КоличествоДолжников);

		ИначеЕсли ИмяРаздела = "Кредиторка" Тогда
			Если ВариантУчета = "Торговля" Тогда
				Данные = ДолгиТорговля(Период, "РасчетыСПоставщиками");
			Иначе
				Данные = ДолгиБухгалтерия(Период, "60", -1);
			КонецЕсли;
			ДобавитьДолги(Строки, "Мы должны поставщикам", Данные, Настройки.КоличествоДолжников);
		КонецЕсли;
	Исключение
		ЗаписатьОшибку("Раздел " + ИмяРаздела + ": " + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		Строки.Добавить(ИмяРаздела + ": не удалось получить данные (подробности в журнале регистрации).");
	КонецПопытки;

КонецПроцедуры

Процедура ДобавитьДолги(Строки, Заголовок, Данные, Количество)

	Строки.Добавить("<b>" + Заголовок + ": " + Сумма(Данные.Всего) + "</b>");
	Номер = 0;
	Для Каждого Долг Из Данные.Долги Цикл
		Номер = Номер + 1;
		Если Номер > Количество Тогда
			Прервать;
		КонецЕсли;
		Строки.Добавить("  " + Номер + ". " + ЭкранироватьHTML(Долг.Наименование) + " - " + Сумма(Долг.Долг));
	КонецЦикла;

КонецПроцедуры

#Область Бухгалтерия

Функция ДеньгиБухгалтерия(Период)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ЕСТЬNULL(СУММА(ВЫБОР
	|				КОГДА Остатки.Счет В ИЕРАРХИИ (&СчетаКассы)
	|					ТОГДА Остатки.СуммаОстатокДт
	|				ИНАЧЕ 0
	|			КОНЕЦ), 0) КАК Касса,
	|	ЕСТЬNULL(СУММА(ВЫБОР
	|				КОГДА Остатки.Счет В ИЕРАРХИИ (&СчетаКассы)
	|					ТОГДА 0
	|				ИНАЧЕ Остатки.СуммаОстатокДт
	|			КОНЕЦ), 0) КАК Банк
	|ИЗ
	|	РегистрБухгалтерии.Хозрасчетный.Остатки(&НаДату, Счет В ИЕРАРХИИ (&СчетаДенег), , ) КАК Остатки";
	Запрос.УстановитьПараметр("НаДату", Период.НаДату);
	Запрос.УстановитьПараметр("СчетаКассы", СчетаПоКодам("50"));
	Запрос.УстановитьПараметр("СчетаДенег", СчетаПоКодам("50,51,52,55"));

	Выборка = Запрос.Выполнить().Выбрать();
	Выборка.Следующий();
	Возврат Новый Структура("Касса, Банк", Выборка.Касса, Выборка.Банк);

КонецФункции

Функция ВыручкаБухгалтерия(Период)

	Счета = СчетаПоКодам("90.01");
	Результат = Новый Структура("ЗаДень, ЗаМесяц", 0, 0);
	Результат.ЗаДень = ОборотБухгалтерия(Период.НачалоДня, Период.КонецДня, Счета, Неопределено, "Кт");
	Результат.ЗаМесяц = ОборотБухгалтерия(Период.НачалоМесяца, Период.КонецДня, Счета, Неопределено, "Кт");
	Возврат Результат;

КонецФункции

Функция ДвижениеДенегБухгалтерия(Период)

	СчетаДенег = СчетаПоКодам("50,51,52,55");
	Результат = Новый Структура("Приход, Расход", 0, 0);
	Результат.Приход = ОборотБухгалтерия(Период.НачалоДня, Период.КонецДня, СчетаДенег, СчетаПоКодам("62"), "Дт");
	Результат.Расход = ОборотБухгалтерия(Период.НачалоДня, Период.КонецДня, СчетаДенег, СчетаПоКодам("60"), "Кт");
	Возврат Результат;

КонецФункции

// Оборот по счетам за период. Сторона - "Дт" или "Кт". КорСчета - Неопределено, если отбор не нужен.
Функция ОборотБухгалтерия(Начало, Конец, Счета, КорСчета, Сторона)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ЕСТЬNULL(СУММА(Обороты.СуммаОборот%Сторона%), 0) КАК Сумма
	|ИЗ
	|	РегистрБухгалтерии.Хозрасчетный.Обороты(&Начало, &Конец, , Счет В ИЕРАРХИИ (&Счета), , , %УсловиеКорСчета%, ) КАК Обороты";
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "%Сторона%", Сторона);
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "%УсловиеКорСчета%",
		?(КорСчета = Неопределено, "", "КорСчет В ИЕРАРХИИ (&КорСчета)"));
	Запрос.УстановитьПараметр("Начало", Начало);
	Запрос.УстановитьПараметр("Конец", Конец);
	Запрос.УстановитьПараметр("Счета", Счета);
	Запрос.УстановитьПараметр("КорСчета", КорСчета);

	Выборка = Запрос.Выполнить().Выбрать();
	Выборка.Следующий();
	Возврат Выборка.Сумма;

КонецФункции

// Долги в разрезе контрагентов по счету расчетов (свернуто по контрагенту: долг минус авансы).
// Знак = 1 для дебиторки (сальдо Дт), -1 для кредиторки (сальдо Кт).
Функция ДолгиБухгалтерия(Период, КодСчета, Знак)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Остатки.Субконто1 КАК Контрагент,
	|	СУММА(Остатки.СуммаОстаток) * &Знак КАК Долг
	|ПОМЕСТИТЬ ВТ_Долги
	|ИЗ
	|	РегистрБухгалтерии.Хозрасчетный.Остатки(&НаДату, Счет В ИЕРАРХИИ (&Счета), &ВидыСубконто, ) КАК Остатки
	|
	|СГРУППИРОВАТЬ ПО
	|	Остатки.Субконто1
	|
	|ИМЕЮЩИЕ
	|	СУММА(Остатки.СуммаОстаток) * &Знак > 0
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ПРЕДСТАВЛЕНИЕ(ВТ_Долги.Контрагент) КАК Наименование,
	|	ВТ_Долги.Долг КАК Долг
	|ИЗ
	|	ВТ_Долги КАК ВТ_Долги
	|
	|УПОРЯДОЧИТЬ ПО
	|	Долг УБЫВ";
	ВидыСубконто = Новый Массив;
	ВидыСубконто.Добавить(ПланыВидовХарактеристик["ВидыСубконтоХозрасчетные"].Контрагенты);
	Запрос.УстановитьПараметр("НаДату", Период.НаДату);
	Запрос.УстановитьПараметр("Счета", СчетаПоКодам(КодСчета));
	Запрос.УстановитьПараметр("ВидыСубконто", ВидыСубконто);
	Запрос.УстановитьПараметр("Знак", Знак);

	Возврат ДолгиИзРезультата(Запрос.Выполнить());

КонецФункции

Функция СчетаПоКодам(КодыСтрокой)

	Счета = Новый Массив;
	Для Каждого Код Из СтрРазделить(КодыСтрокой, ",", Ложь) Цикл
		Счет = ПланыСчетов["Хозрасчетный"].НайтиПоКоду(СокрЛП(Код));
		Если ЗначениеЗаполнено(Счет) Тогда
			Счета.Добавить(Счет);
		КонецЕсли;
	КонецЦикла;
	Возврат Счета;

