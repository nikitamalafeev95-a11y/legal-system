			+ ИтогРегистраНакопления(ИмяРегистра, "Приход", Период.НачалоДня, Период.КонецДня);
		Результат.Расход = Результат.Расход
			+ ИтогРегистраНакопления(ИмяРегистра, "Расход", Период.НачалоДня, Период.КонецДня);
