// Выполняет HTTPS-запрос.
//
// Возвращаемое значение:
//   Структура - Ошибка (Строка, пустая при коде ответа 200), Тело (Строка).
Функция ВыполнитьЗапрос(Сервер, Адрес, Метод, Заголовки, Тело, Настройки, ИспользоватьПрокси)

	Результат = Новый Структура("Ошибка, Тело", "", "");

	Попытка
		Прокси = Неопределено;
		Если ИспользоватьПрокси И ЗначениеЗаполнено(Настройки.ПроксиСервер) Тогда
			Прокси = Новый ИнтернетПрокси;
			Прокси.Установить("https", Настройки.ПроксиСервер, Настройки.ПроксиПорт,
				Настройки.ПроксиПользователь, Настройки.ПроксиПароль);
		КонецЕсли;

		Соединение = Новый HTTPСоединение(Сервер, 443, , , Прокси, 30, Новый ЗащищенноеСоединениеOpenSSL);
		Запрос = Новый HTTPЗапрос(Адрес);
		Запрос.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
		Если Заголовки <> Неопределено Тогда
			Для Каждого Заголовок Из Заголовки Цикл
				Запрос.Заголовки.Вставить(Заголовок.Ключ, Заголовок.Значение);
			КонецЦикла;
		КонецЕсли;

		Если Метод = "GET" Тогда
			Ответ = Соединение.Получить(Запрос);
		Иначе
			Запрос.УстановитьТелоИзСтроки(Тело, КодировкаТекста.UTF8, ИспользованиеByteOrderMark.НеИспользовать);
			Ответ = Соединение.ОтправитьДляОбработки(Запрос);
		КонецЕсли;

		Результат.Тело = Ответ.ПолучитьТелоКакСтроку();
		Если Ответ.КодСостояния <> 200 Тогда
			Результат.Ошибка = "Сервер " + Сервер + " вернул код " + Ответ.КодСостояния + ": " + Результат.Тело;
		КонецЕсли;
	Исключение
		Результат.Ошибка = "Нет связи с " + Сервер + ": " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;

	Возврат Результат;

КонецФункции

Процедура УчестьРезультатОтправки(Результат, Получатель, Ошибка)

	Если Ошибка = "" Тогда
		Результат.Отправлено = Результат.Отправлено + 1;
	Иначе
		Результат.Ошибки.Добавить(Получатель + ": " + Ошибка);
	КонецЕсли;

