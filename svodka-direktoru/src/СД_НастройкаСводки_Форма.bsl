// Модуль формы обработки СД_НастройкаСводки.
//
// Реквизиты формы (имена должны совпадать с ключами настроек):
//   ТокенTelegram            - Строка
//   ЧатыTelegram             - Строка
//   ТокенMAX                 - Строка
//   ЧатыMAX                  - Строка
//   ОтправлятьПоРасписанию   - Булево
//   ВремяОтправки            - Дата (состав даты: Время)
//   ПоказыватьДеньги         - Булево
//   ПоказыватьВыручку        - Булево
//   ПоказыватьДвижениеДенег  - Булево
//   ПоказыватьДебиторку      - Булево
//   ПоказыватьКредиторку     - Булево
//   КоличествоДолжников      - Число (2, 0)
//   ПроксиСервер             - Строка
//   ПроксиПорт               - Число (5, 0)
//   ПроксиПользователь       - Строка
//   ПроксиПароль             - Строка (режим пароля)
//   Предпросмотр             - Строка (многострочное поле, только просмотр)
//
// Команды формы: Сохранить, ПоказатьПредпросмотр, ОтправитьСейчас, НайтиЧатыTelegram.

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	ЗаполнитьЗначенияСвойств(ЭтотОбъект, СД_Сводка.ПолучитьНастройки());

КонецПроцедуры

&НаКлиенте
Процедура Сохранить(Команда)

	СохранитьНаСервере();
	ПоказатьОповещениеПользователя("Настройки сохранены");

КонецПроцедуры

&НаКлиенте
Процедура ПоказатьПредпросмотр(Команда)

	ПоказатьПредпросмотрНаСервере();

КонецПроцедуры

&НаКлиенте
Процедура ОтправитьСейчас(Команда)

	ТекстРезультата = ОтправитьСейчасНаСервере();
	ПоказатьПредупреждение(, ТекстРезультата);

КонецПроцедуры

&НаКлиенте
Процедура НайтиЧатыTelegram(Команда)

	Если ПустаяСтрока(ТокенTelegram) Тогда
		ПоказатьПредупреждение(, "Сначала укажите токен бота Telegram.");
		Возврат;
	КонецЕсли;
	ПоказатьПредупреждение(, НайтиЧатыTelegramНаСервере());

КонецПроцедуры

&НаСервере
Функция НастройкиИзФормы()

	Настройки = СД_Сводка.НастройкиПоУмолчанию();
	ЗаполнитьЗначенияСвойств(Настройки, ЭтотОбъект);
	Возврат Настройки;

КонецФункции

&НаСервере
Процедура СохранитьНаСервере()

	СД_Сводка.СохранитьНастройки(НастройкиИзФормы());

КонецПроцедуры

&НаСервере
Процедура ПоказатьПредпросмотрНаСервере()

	Текст = СД_Сводка.ТекстСводки(НастройкиИзФормы());
	Текст = СтрЗаменить(Текст, "<b>", "");
	Текст = СтрЗаменить(Текст, "</b>", "");
	Предпросмотр = Текст;

КонецПроцедуры

&НаСервере
Функция ОтправитьСейчасНаСервере()

	Настройки = НастройкиИзФормы();
	СД_Сводка.СохранитьНастройки(Настройки);

	Результат = СД_Сводка.ОтправитьСводку(Настройки);
	Если Результат.Успех Тогда
		Возврат "Сводка отправлена. Получателей: " + Результат.Отправлено;
	КонецЕсли;
	Возврат "Отправлено: " + Результат.Отправлено + ". Ошибки:" + Символы.ПС
		+ СтрСоединить(Результат.Ошибки, Символы.ПС);

КонецФункции

&НаСервере
Функция НайтиЧатыTelegramНаСервере()

	Результат = СД_Сводка.НайтиЧатыTelegram(НастройкиИзФормы());
	Если Результат.Ошибка <> "" Тогда
		Возврат Результат.Ошибка;
	КонецЕсли;
	Если Результат.Чаты.Количество() = 0 Тогда
		Возврат "Чаты не найдены. Напишите боту любое сообщение и повторите поиск.";
	КонецЕсли;
	Возврат "Найдены чаты (скопируйте число в поле ""Чаты Telegram""):" + Символы.ПС
		+ СтрСоединить(Результат.Чаты, Символы.ПС);

КонецФункции
